{
  "name": "transcriptfetch-mcp",
  "version": "0.2.5",
  "description": "Model Context Protocol (MCP) server for TranscriptFetch: give Claude, Cursor, or any MCP client video and audio transcripts - YouTube, TikTok, Instagram, podcasts and media URLs, with automatic AI transcription when captions don't exist - plus video search, channel and playlist listing.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cursor",
    "youtube",
    "youtube-transcript",
    "tiktok",
    "instagram",
    "transcript",
    "transcription",
    "captions",
    "speech-to-text",
    "ai",
    "llm",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "TranscriptFetch <support@transcriptfetch.com>",
  "homepage": "https://transcriptfetch.com/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TranscriptFetch/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/TranscriptFetch/mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "transcriptfetch-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
